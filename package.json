{
  "name": "porthole",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drive and share your local Claude Code sessions from a browser, over Tailscale.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/retransmit/porthole.git"
  },
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "porthole": "bin/porthole.mjs"
  },
  "scripts": {
    "start": "node bin/porthole.mjs start",
    "test": "node --test --test-concurrency=1",
    "test:watch": "node --test --watch",
    "invite": "node bin/porthole.mjs invite",
    "sessions": "node bin/porthole.mjs ls",
    "tailscale:serve": "node bin/porthole.mjs tailscale-serve"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "ws": "^8.21.3"
  }
}
